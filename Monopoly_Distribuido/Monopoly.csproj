<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Monopoly/ es un proyecto de consola aparte (servidor/cliente),
         con su propio .csproj. No debe compilarse como parte de Godot. -->
    <Compile Remove="Monopoly/**/*.cs" />
    <!-- .godot/ tiene archivos generados internamente por el propio
         editor de Godot; no se deben compilar manualmente. -->
    <Compile Remove=".godot/**/*.cs" />
  </ItemGroup>
</Project>